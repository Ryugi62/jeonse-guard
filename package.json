{
  "name": "jeonse-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Jeonse lease risk checker that cites official Korean statute text or stays silent.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fetch:statutes": "node --experimental-strip-types scripts/fetch-statutes.ts",
    "eval:clauses": "node --experimental-strip-types scripts/eval-clauses.ts",
    "serve": "node --experimental-strip-types scripts/serve.ts",
    "build:vercel": "node --experimental-strip-types scripts/build-vercel.ts",
    "smoke": "node --experimental-strip-types scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
